# PostgreSQL connection string (Supabase/Neon/RDS/plain PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Long random secret for admin JWT sessions (32+ characters)
AUTH_SECRET=replace-with-a-long-random-secret

# Public production URL used by canonical URLs, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional: only used if you customize the seed defaults before first bootstrap.
# Do NOT commit real credentials.
# ADMIN_EMAIL=admin@apkvault.com
# ADMIN_PASSWORD=change-this-before-production

# Maximum URLs per generated sitemap file (Google limit: 50,000).
# Keep at or below 50000; 50000 is the default.
SITEMAP_URL_LIMIT=50000
